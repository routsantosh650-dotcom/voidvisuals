rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net — default deny everything the blocks below do not allow.
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // The two studio accounts. The same allowlist is enforced in worker.ts, and the browser
    // bundle only ever sees SHA-256 digests of these addresses (src/lib/adminGate.ts).
    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'voidvisuals999@gmail.com' ||
        request.auth.token.email == 'routsantosh650@gmail.com'
      );
    }

    function isMe(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // 3. Validators

    // /siteConfig/main — 14 content keys plus the two bookkeeping keys. The browser writer is
    // siteConfigFields() in src/data/vvData.ts; both lists are maintained together on purpose,
    // because an unknown key makes the whole save fail.
    function isValidSiteConfig(data) {
      return data.keys().hasAll([
        'brandName', 'heroTitle', 'heroSubtitle', 'studioLine', 'contactEmail', 'contactPhone',
        'whatsappUrl', 'instagramUrl', 'behanceUrl', 'founderName', 'founderQuote', 'statusNote',
        'discountOffer', 'discountEndsAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'brandName', 'heroTitle', 'heroSubtitle', 'studioLine', 'contactEmail', 'contactPhone',
        'whatsappUrl', 'instagramUrl', 'behanceUrl', 'founderName', 'founderQuote', 'statusNote',
        'discountOffer', 'discountEndsAt', 'updatedBy', 'updatedAt'
      ]) &&
      data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 60 &&
      data.heroTitle is string && data.heroTitle.size() <= 120 &&
      data.heroSubtitle is string && data.heroSubtitle.size() <= 300 &&
      data.studioLine is string && data.studioLine.size() <= 120 &&
      data.contactEmail is string && data.contactEmail.size() <= 120 &&
      data.contactPhone is string && data.contactPhone.size() <= 40 &&
      data.whatsappUrl is string && data.whatsappUrl.size() <= 200 &&
      data.instagramUrl is string && data.instagramUrl.size() <= 200 &&
      data.behanceUrl is string && data.behanceUrl.size() <= 200 &&
      data.founderName is string && data.founderName.size() <= 80 &&
      data.founderQuote is string && data.founderQuote.size() <= 400 &&
      data.statusNote is string && data.statusNote.size() <= 120 &&
      data.discountOffer is string && data.discountOffer.size() <= 240 &&
      data.discountEndsAt is int && data.discountEndsAt >= 0 && data.discountEndsAt <= 4102444800000 &&
      data.updatedBy is string && data.updatedBy.size() <= 120 &&
      data.updatedAt is timestamp;
    }

    // /plans/{id} — website tiers, add-ons and the care plan. Prices are public.
    function isValidPlan(data) {
      return data.keys().hasOnly([
        'name', 'tagline', 'category', 'priceInr', 'oldPriceInr', 'periodLabel',
        'features', 'badge', 'popular', 'sortOrder', 'active', 'updatedBy', 'updatedAt'
      ]) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
      data.tagline is string && data.tagline.size() <= 160 &&
      data.category in ['website', 'addon', 'care'] &&
      data.priceInr is int && data.priceInr >= 1 && data.priceInr <= 200000 &&
      data.oldPriceInr is int && data.oldPriceInr >= 0 && data.oldPriceInr <= 200000 &&
      data.periodLabel is string && data.periodLabel.size() <= 40 &&
      data.features is list && data.features.size() <= 24 &&
      data.features.all(f, f is string && f.size() <= 120) &&
      data.badge is string && data.badge.size() <= 28 &&
      data.popular is bool && data.active is bool &&
      data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 999;
    }

    // /work/{id} — portfolio entries.
    function isValidWork(data) {
      return data.keys().hasOnly([
        'title', 'client', 'category', 'summary', 'detail', 'tags', 'year',
        'url', 'accent', 'featured', 'status', 'sortOrder', 'updatedBy', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
      data.client is string && data.client.size() <= 80 &&
      data.category in ['business', 'creator', 'ecommerce', 'upgrade', 'landing'] &&
      data.summary is string && data.summary.size() <= 200 &&
      data.detail is string && data.detail.size() <= 600 &&
      data.tags is list && data.tags.size() <= 8 &&
      data.tags.all(t, t is string && t.size() <= 40) &&
      data.year is int && data.year >= 2000 && data.year <= 2100 &&
      data.url is string && data.url.size() <= 200 &&
      data.accent is string && data.accent.size() == 7 && data.accent.matches('^#[0-9a-fA-F]{6}$') &&
      data.featured is bool &&
      data.status in ['live', 'sample'] &&
      data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 999;
    }

    // /testimonials/{id}
    function isValidTestimonial(data) {
      return data.keys().hasOnly(['author', 'role', 'text', 'rating', 'approved', 'sortOrder']) &&
      data.author is string && data.author.size() >= 1 && data.author.size() <= 60 &&
      data.role is string && data.role.size() <= 70 &&
      data.text is string && data.text.size() >= 8 && data.text.size() <= 400 &&
      data.rating is int && data.rating >= 1 && data.rating <= 5 &&
      data.approved is bool &&
      data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 999;
    }

    // /briefs/{id} — one project enquiry. Written by the Worker after per-IP rate limiting,
    // and re-validated here so a direct REST client cannot smuggle anything in.
    function isValidBrief(data) {
      return data.keys().hasAll([
        'name', 'email', 'phone', 'service', 'budget', 'details', 'link', 'coupon',
        'ownerEmail', 'status', 'note', 'timeline', 'createdAt', 'createdAtMs'
      ]) && data.keys().hasOnly([
        'name', 'email', 'phone', 'service', 'budget', 'details', 'link', 'coupon',
        'ownerEmail', 'status', 'note', 'timeline', 'createdAt', 'createdAtMs'
      ]) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
      data.email is string && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[a-zA-Z]{2,}$') &&
      data.email.size() <= 120 &&
      data.phone is string && data.phone.size() <= 24 &&
      // "service" is a keyword in the rules language (service cloud.firestore), so this one field
      // has to be reached with ['…'] instead of .service — otherwise the parser fails on this line.
      data['service'] in ['New website', 'Website upgrade / redesign', 'Landing page', 'Online store', 'Portfolio / personal site', 'SEO & speed tune-up', 'Something else'] &&
      data.budget is string && data.budget.size() <= 40 &&
      data.details is string && data.details.size() >= 12 && data.details.size() <= 1200 &&
      data.link is string && data.link.size() <= 200 &&
      data.coupon is string && data.coupon.size() <= 24 &&
      data.ownerEmail is string && data.ownerEmail.size() <= 120 &&
      data.status == 'new' &&
      data.note is string && data.note.size() == 0 &&
      data.timeline is list && data.timeline.size() <= 1 &&
      // The Worker stamps createdAt a few milliseconds before the commit reaches Firestore, so
      // equality with request.time would reject every single brief, and the rules language has no
      // usable duration literal for a tolerance window. The epoch-ms twin below is what keeps the
      // field honest: 2025-01-01 to 2100-01-01, nothing outside it is accepted.
      data.createdAt is timestamp &&
      data.createdAtMs is int && data.createdAtMs >= 1735689600000 &&
      data.createdAtMs <= 4102444800000;
    }

    // /coupons/{code}
    function isValidCoupon(data) {
      return data.keys().hasOnly(['discountPercent', 'label', 'active', 'updatedBy', 'updatedAt']) &&
      data.discountPercent is int && data.discountPercent >= 1 && data.discountPercent <= 90 &&
      data.active is bool &&
      data.label is string && data.label.size() <= 60;
    }

    // /auditLog/{id} — append-only. createdAt comes from the server clock, never the writer's.
    function isValidAuditEntry(data) {
      return data.keys().hasAll([
        'createdAt', 'clientTime', 'actor', 'actorUid', 'category',
        'action', 'target', 'summary', 'changes', 'page', 'agent', 'ip'
      ]) && data.keys().hasOnly([
        'createdAt', 'clientTime', 'actor', 'actorUid', 'category',
        'action', 'target', 'summary', 'changes', 'page', 'agent', 'ip'
      ]) &&
      data.createdAt is timestamp &&
      data.clientTime is string && data.clientTime.size() >= 1 && data.clientTime.size() <= 40 &&
      data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 200 &&
      data.actorUid is string && data.actorUid.size() <= 128 &&
      data.category in ['ADMIN', 'CUSTOMER', 'AUTH'] &&
      data.action is string && data.action.size() >= 1 && data.action.size() <= 40 &&
      data.target is string && data.target.size() <= 200 &&
      data.summary is string && data.summary.size() <= 300 &&
      data.changes is list && data.changes.size() <= 25 &&
      data.changes.all(change, change is string && change.size() <= 240) &&
      data.page is string && data.page.size() <= 200 &&
      data.agent is string && data.agent.size() <= 80 &&
      data.ip is string && data.ip.size() <= 60;
    }

    // 4. Collections

    // Connection health check used by src/firebase.ts
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    match /siteConfig/{configId} {
      allow get: if configId == 'main' && existing().brandName.size() >= 1;
      allow list: if false;

      allow create: if isBootstrappedAdmin() && configId == 'main' && isValidSiteConfig(incoming());

      allow update: if isBootstrappedAdmin() && configId == 'main' &&
        isValidSiteConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'brandName', 'heroTitle', 'heroSubtitle', 'studioLine', 'contactEmail', 'contactPhone',
          'whatsappUrl', 'instagramUrl', 'behanceUrl', 'founderName', 'founderQuote', 'statusNote',
          'discountOffer', 'discountEndsAt', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if false;
    }

    match /plans/{planId} {
      allow get, list: if isValidId(planId) && existing().priceInr >= 1;
      allow create, update, delete: if isBootstrappedAdmin() && isValidPlan(incoming());
    }

    match /work/{workId} {
      allow get, list: if isValidId(workId);
      allow create, update, delete: if isBootstrappedAdmin() && isValidWork(incoming());
    }

    match /testimonials/{itemId} {
      // Public sees approved quotes only; the studio sees everything.
      allow get: if isBootstrappedAdmin() || existing().approved == true;
      allow list: if isBootstrappedAdmin() || resource.data.approved == true;
      allow create: if isBootstrappedAdmin() && isValidTestimonial(incoming());
      allow update: if isBootstrappedAdmin() && isValidTestimonial(incoming());
      allow delete: if isBootstrappedAdmin();
    }

    match /coupons/{code} {
      allow get, list: if true;
      allow create, update, delete: if isBootstrappedAdmin() && isValidCoupon(incoming());
    }

    // Project briefs. Anyone (even signed out) may create one through the Worker path; only the
    // studio admins may read the inbox, plus the customer who owns the brief.
    match /briefs/{briefId} {
      allow get: if isBootstrappedAdmin() || (isSignedIn() && existing().ownerEmail == request.auth.token.email);
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.ownerEmail == request.auth.token.email);

      allow create: if isValidBrief(incoming()) && isValidId(briefId);

      // Status changes and replies are admin-only, and the original enquiry stays untouched.
      allow update: if isBootstrappedAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'timeline']) &&
        incoming().status in ['new', 'reviewing', 'quoted', 'in-progress', 'delivered', 'archived'] &&
        incoming().name == existing().name &&
        incoming().email == existing().email &&
        incoming().details == existing().details;

      allow delete: if isBootstrappedAdmin();
    }

    match /auditLog/{docId} {
      allow get, list: if isBootstrappedAdmin();

      allow create: if isValidAuditEntry(incoming()) &&
        (
          // Enquiries and project events triggered from the public site.
          incoming().category == 'CUSTOMER'

          // Login-flow events. The actor may legitimately be signed out (wrong password,
          // rate limit, allowlist denial), so no session is required - but the entry must
          // target the console and carry a real email address.
          || (incoming().category == 'AUTH' &&
              incoming().target == 'studio-console' &&
              incoming().actor.matches('^[^@ ]+@[^@ ]+\\.[a-zA-Z]{2,}$'))

          // Content, pricing and status changes need the admin's own verified session.
          || (incoming().category == 'ADMIN' &&
              isBootstrappedAdmin() &&
              incoming().actor == request.auth.token.email)
        );

      allow update, delete: if false;
    }
  }
}
